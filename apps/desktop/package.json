{
  "name": "@codezal/desktop",
  "productName": "Codezal",
  "version": "1.2.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "main": "./out/main/index.mjs",
  "description": "Codezal desktop app",
  "author": "Esmworks",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "package": "node scripts/release-notes.mjs && electron-vite build && electron-builder --mac --dir",
    "package:mac": "node scripts/release-notes.mjs && electron-vite build && electron-builder --mac --publish never",
    "package:mac:unsigned": "node scripts/release-notes.mjs && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg -c.mac.identity=null -c.mac.notarize=false -c.dmg.sign=false -c.electronFuses.resetAdHocDarwinSignature=true",
    "package:win": "node scripts/release-notes.mjs && electron-vite build && electron-builder --win --publish never",
    "package:linux": "node scripts/release-notes.mjs && electron-vite build && electron-builder --linux --publish never",
    "package:inspect": "node scripts/inspect-asar.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:upload": "node scripts/publish-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@codezal/agent": "workspace:*",
    "@codezal/contracts": "workspace:*",
    "@codezal/i18n": "workspace:*",
    "@codezal/ui": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-server": "0.87.1",
    "@lexical/react": "0.51.0",
    "@napi-rs/canvas": "1.0.9",
    "docx": "9.7.2",
    "electron-updater": "6.8.9",
    "i18next": "26.4.2",
    "lexical": "0.51.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.3.289",
    "react-i18next": "17.0.15",
    "simple-git": "3.36.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6",
    "zustand": "5.0.15"
  }
}
