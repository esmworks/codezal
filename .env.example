# Yayıncının Google OAuth istemcisi. Bu dosya örnektir; gerçek değerler `.env` içine yazılır ve
# git'e girmez. Google Cloud > Google Auth Platform > Clients altında "Masaüstü uygulaması" tipinde
# istemci oluştur. Boş bırakılırsa Google servisleri için kullanıcı kendi istemcisini girer.
CODEZAL_GOOGLE_CLIENT_ID=
CODEZAL_GOOGLE_CLIENT_SECRET=
